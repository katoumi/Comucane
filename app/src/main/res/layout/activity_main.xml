<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rehaul_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/voiceBottomBar"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ComuCane.Title"
                android:text="@string/app_title"
                android:lineSpacingExtra="4sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ready_to_guide"
                android:textColor="@color/brand_text_on_dark"
                android:alpha="0.8"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>

            <!-- Navigation Card -->
            <LinearLayout
                android:id="@+id/btnStartNavigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_rehaul_container"
                android:orientation="vertical"
                android:padding="28dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Start navigation assistant"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_logs"
                    app:tint="@color/brand_primary"
                    android:contentDescription="@null"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/TextAppearance.ComuCane.CardTitle"
                    android:text="Start Navigation"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/active_features"
                    android:textColor="@color/brand_text_on_card"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvVoiceFeature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="80dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_rehaul_button"
                        android:gravity="center"
                        android:text="@string/feature_voice"
                        android:textColor="@color/brand_text_on_dark"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvVibrationFeature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="80dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_rehaul_button"
                        android:gravity="center"
                        android:text="@string/feature_vibration"
                        android:textColor="@color/brand_text_on_dark"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvGpsFeature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="80dp"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_rehaul_button"
                        android:gravity="center"
                        android:text="@string/feature_gps"
                        android:textColor="@color/brand_text_on_dark"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true">

                <!-- Device Card -->
                <LinearLayout
                    android:id="@+id/btnDeviceConnection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_rehaul_container"
                    android:padding="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Device connection settings"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_device"
                        app:tint="@color/brand_text_on_card"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Device"
                        android:textColor="@color/brand_text_on_card"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Logs Card -->
                <LinearLayout
                    android:id="@+id/btnLogs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_rehaul_container"
                    android:padding="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Obstacle logs"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_logs"
                        app:tint="@color/brand_text_on_card"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Logs"
                        android:textColor="@color/brand_text_on_card"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Settings Card -->
                <LinearLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_rehaul_container"
                    android:padding="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="App settings"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/brand_text_on_card"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Settings"
                        android:textColor="@color/brand_text_on_card"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Emergency Card -->
                <LinearLayout
                    android:id="@+id/btnEmergency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_rehaul_button_crimson"
                    android:padding="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Emergency SOS alert"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_emergency"
                        app:tint="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Emergency"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

            </GridLayout>

            <!-- Hidden for compatibility -->
            <View android:id="@+id/btnPageVoice" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/voiceBottomBar"
        layout="@layout/layout_hold_speak_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
