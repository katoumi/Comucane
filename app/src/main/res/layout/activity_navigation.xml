<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rehaul_gradient"
    android:orientation="vertical">

    <!-- ── TOP BAR ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="@string/navigating"
            android:textColor="@color/brand_text_on_dark"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sensors_active"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/navigationRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rehaul_container"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- MAP CARD (Styled as a window) -->
            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_rehaul_container"
                android:padding="0dp">

                <org.osmdroid.views.MapView
                    android:id="@+id/osmMapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:clipToOutline="true" />
            </FrameLayout>

            <!-- STATUS CARD -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_rehaul_container"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:minHeight="200dp">

                <TextView
                    android:id="@+id/tvNavMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Assist"
                    android:textColor="@color/brand_text_on_card"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:alpha="0.6"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvNavStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Clear"
                    android:textColor="@color/brand_status_green"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Path ahead is safe"
                    android:textColor="@color/brand_text_on_card"
                    android:textSize="18sp"
                    android:gravity="center" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRepeatAlert"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rehaul_button"
                    android:text="@string/repeat"
                    android:textColor="@color/brand_text_light"
                    android:textStyle="bold"
                    style="?android:attr/borderlessButtonStyle" />

                <Button
                    android:id="@+id/btnStopNavigation"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rehaul_button"
                    android:backgroundTint="@color/brand_primary"
                    android:text="@string/stop"
                    android:textColor="@color/brand_text_light"
                    android:textStyle="bold"
                    style="?android:attr/borderlessButtonStyle" />

            </LinearLayout>

            <!-- Indicators -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery: --%"
                    android:textColor="@color/brand_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="8dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="#20000000"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gps_status_active"
                    android:textColor="@color/brand_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/voiceBottomBar"
        layout="@layout/layout_hold_speak_bar" />

</LinearLayout>
