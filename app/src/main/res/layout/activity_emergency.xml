<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rehaul_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/voiceBottomBar"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="ComuCane"
                android:textColor="@color/brand_text_on_dark"
                android:textSize="36sp"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency"
                android:textColor="@color/brand_text_on_dark"
                android:alpha="0.8"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>

            <!-- SOS Hero Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_rehaul_button_crimson"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="SOS"
                    android:textColor="@color/white"
                    android:textSize="56sp" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ready to call"
                    android:textColor="@color/white"
                    android:alpha="0.9"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Contact Box -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="Emergency Contact"
                android:textColor="@color/brand_text_on_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rehaul_container"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tvContactName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading contact..."
                    android:textColor="@color/brand_text_on_card"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContactPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="—"
                    android:textColor="@color/brand_primary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Location Box -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="Location Status"
                android:textColor="@color/brand_text_on_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvLocationInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rehaul_container"
                android:gravity="center"
                android:padding="20dp"
                android:text="Acquiring GPS location..."
                android:textColor="@color/brand_text_on_card"
                android:alpha="0.7"
                android:textSize="13sp" />

            <!-- Actions -->
            <Button
                android:id="@+id/btnCallNow"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_rehaul_button_crimson"
                android:text="Call Now"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnCancelEmergency"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="40dp"
                android:background="@drawable/bg_rehaul_button"
                android:backgroundTint="#20000000"
                android:text="Cancel"
                android:textColor="@color/brand_text_on_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/voiceBottomBar"
        layout="@layout/layout_hold_speak_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
